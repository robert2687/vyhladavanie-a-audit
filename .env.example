# AI provider keys. Users can also enter custom keys in the application UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"
# PERPLEXITY_API_KEY="MY_PERPLEXITY_API_KEY"
# NVIDIA_API_KEY="MY_NVIDIA_API_KEY"
# DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"
# OPENAI_API_KEY="MY_OPENAI_API_KEY"
# XAI_API_KEY="MY_XAI_API_KEY"

# Public application URL used for hosted integrations and callbacks.
APP_URL="MY_APP_URL"

# Optional: when blank/omitted, frontend API calls use same-origin /api routes.
# Set only if the API is hosted separately from the Vite/Express frontend.
# REACT_APP_BACKEND_URL="http://localhost:8001"

# Required for email/password auth and saved pipeline storage.
# Without MongoDB configured, unauthenticated /api/auth/me returns 401 and the app shows login,
# but register/login and cloud pipeline storage are unavailable.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="slovak_b2b"
JWT_SECRET="change-me-to-a-long-random-secret"

# Optional admin seeding on server startup.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="change-me-strong-password"

# Optional transactional email for emailing the signed-in user their saved leads.
# EMERGENT_EMAIL_KEY="MY_EMERGENT_EMAIL_KEY"
# EMAIL_FROM_NAME="Slovak B2B Lead Generator"
# EMAIL_REPLY_TO="support@example.com"
